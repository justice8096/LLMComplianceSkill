{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "lib": [
      "ES2020"
    ],
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "outDir": "./dist",
    "rootDir": ".",
    "typeRoots": [
      "./tooling/node_modules/@types"
    ],
    "types": [
      "node"
    ]
  },
  "include": [
    "build.ts",
    "source/**/*"
  ],
  "exclude": [
    "node_modules",
    "tooling",
    "dist"
  ]
}
